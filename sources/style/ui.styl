/*
 * The interface layer: everything that sits on top of the 3D world.
 *
 * One rule keeps it from fighting the world: the world is hand-built and
 * warm, the interface is dark frosted glass with system type. The two never
 * share a surface. Used by the short version (Profile.js), the presentations
 * (Keynote.js) and the heads-up buttons.
 */
$text = #f5f5f7
$secondary = rgba(235, 235, 245, 0.62)
$tertiary = rgba(235, 235, 245, 0.38)
$glass = rgba(255, 255, 255, 0.07)
$glass-strong = rgba(255, 255, 255, 0.13)
$stroke = rgba(255, 255, 255, 0.09)
$blue = #0a84ff
$green = #30d158
$spring = cubic-bezier(0.2, 0.8, 0.2, 1)

/*
 * Scrim: the world stays visible, blurred, behind every sheet
 */
.modals
    background rgba(9, 9, 12, 0.74)
    backdrop-filter blur(44px) saturate(135%)
    -webkit-backdrop-filter blur(44px) saturate(135%)
    transition opacity 0.45s $spring

    *::selection
        color #ffffff
        background $blue

/*
 * Shared pieces
 */
.pill
    display inline-flex
    align-items center
    justify-content center
    height 38px
    padding 0 17px
    border-radius 19px
    background $glass-strong
    box-shadow inset 0 0 0 1px $stroke
    color $text
    font-size 15px
    font-weight 600
    letter-spacing -0.01em
    line-height 1
    text-decoration none
    white-space nowrap
    cursor pointer
    transition background 0.25s, transform 0.3s $spring

    html:not(.is-mode-touch) &:hover
        background rgba(255, 255, 255, 0.2)
        transform scale(1.035)

    &:active
        transform scale(0.96)

    .arrow
        margin-left 4px
        font-size 0.85em
        opacity 0.55

    &.is-solid
        background $text
        box-shadow none
        color #000000

        html:not(.is-mode-touch) &:hover
            background #ffffff

    &.is-quiet
        background none
        box-shadow none
        color $blue
        padding 0 8px

        html:not(.is-mode-touch) &:hover
            background none

.glass
    position relative
    border-radius 26px
    background $glass
    box-shadow inset 0 0 0 1px $stroke

    // A soft light that follows the pointer
    &::before
        content ''
        position absolute
        inset 0
        border-radius inherit
        background radial-gradient(520px circle at var(--light-x, 50%) var(--light-y, 0%), rgba(255, 255, 255, 0.1), transparent 62%)
        opacity 0
        transition opacity 0.35s
        pointer-events none

    html:not(.is-mode-touch) &:hover::before
        opacity 1

.emblem
    flex none
    display flex
    align-items center
    justify-content center
    width 52px
    height 52px
    overflow hidden
    border-radius 13px
    background rgba(255, 255, 255, 0.92)
    color #1d1d1f
    font-size 15px
    font-weight 700
    letter-spacing -0.02em

    img
        display block
        width 100%
        height 100%
        object-fit cover

    &.is-monogram
        background $glass-strong
        box-shadow inset 0 0 0 1px $stroke
        color $text

// Things rise into place as they come into view
.js-reveal
    opacity 0
    transform translateY(30px) scale(0.985)
    filter blur(10px)
    transition opacity 0.9s $spring, transform 1.05s $spring, filter 0.9s $spring
    transition-delay calc(var(--i, 0) * 75ms)

    &.is-in
        opacity 1
        transform none
        filter none

    @media (prefers-reduced-motion: reduce)
        opacity 1
        transform none
        filter none
        transition none

/*
 * Heads-up buttons
 */
.profile-trigger
    display none
    position absolute
    top 20px
    left 20px
    z-index 9
    height 44px
    padding 0 18px 0 13px
    border-radius 22px
    background rgba(22, 22, 26, 0.62)
    backdrop-filter blur(24px) saturate(180%)
    -webkit-backdrop-filter blur(24px) saturate(180%)
    box-shadow inset 0 0 0 1px $stroke
    color $text
    font-size 15px
    font-weight 600
    letter-spacing -0.01em
    transition transform 0.3s $spring, opacity 0.3s, background 0.25s

    html.is-started &
        display block

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-cinematic &
        opacity 0
        pointer-events none

    .button-inner
        display flex
        align-items center
        gap 8px

    .profile-icon
        display block
        width 20px
        height 20px

    html:not(.is-mode-touch) &:hover
        background rgba(22, 22, 26, 0.82)
        transform scale(1.04)

    &:active
        transform scale(0.96)

    @media only screen and (max-width 520px)
        top 12px
        left 12px

.menu-trigger,
.map-trigger
    right 20px
    width 44px
    height 44px

    @media only screen and (max-width 520px)
        right 12px

    .button-inner
        top 0
        left 0
        width 100%
        height 100%
        border-radius 22px
        background rgba(22, 22, 26, 0.62)
        backdrop-filter blur(24px) saturate(180%)
        -webkit-backdrop-filter blur(24px) saturate(180%)
        box-shadow inset 0 0 0 1px $stroke
        transition transform 0.3s $spring, opacity 0.3s, background 0.25s

        &::after
            display none

        html.input-filter-menu &,
        html.input-filter-modal &,
        html.input-filter-intro &,
        html.input-filter-cinematic &
            transform scale(0.6)
            opacity 0

    html:not(.is-mode-touch) &:hover .button-inner
        background rgba(22, 22, 26, 0.82)
        transform scale(1.06)

.map-trigger
    top 74px

.home-actions
    display flex
    flex-wrap wrap
    gap 10px
    margin-top 1.3em

/*
 * Sheets: the short version and the presentations take the whole screen
 */
.modals .modal.sheet
    position absolute
    inset 0
    flex-direction column
    color $text

    &.is-displayed
        display flex

    a:not(.pill)
        color inherit

.sheet-close
    position absolute
    top 16px
    right 20px
    z-index 5
    display flex
    align-items center
    justify-content center
    width 38px
    height 38px
    border-radius 19px
    background $glass-strong
    box-shadow inset 0 0 0 1px $stroke
    color $text
    transition background 0.25s, transform 0.3s $spring

    html:not(.is-mode-touch) &:hover
        background rgba(255, 255, 255, 0.22)
        transform scale(1.08)

    &:active
        transform scale(0.94)

    @media only screen and (max-width 520px)
        right 12px

.sheet-bar
    position absolute
    top 0
    left 0
    right 0
    z-index 4
    display flex
    align-items center
    gap 6px
    height 70px
    padding 0 76px 0 28px
    transition background 0.4s, backdrop-filter 0.4s

    &.is-scrolled
        background rgba(12, 12, 16, 0.55)
        backdrop-filter blur(26px) saturate(170%)
        -webkit-backdrop-filter blur(26px) saturate(170%)
        box-shadow 0 1px 0 $stroke

    @media only screen and (max-width 760px)
        padding 0 62px 0 14px
        overflow-x auto

    .nav-name
        margin-right auto
        font-size 16px
        font-weight 700
        letter-spacing -0.015em
        white-space nowrap

        @media only screen and (max-width 760px)
            display none

    .nav-items
        display flex
        gap 2px

    .nav-item
        height 34px
        padding 0 13px
        border-radius 17px
        font-size 14px
        font-weight 500
        color $secondary
        white-space nowrap
        transition background 0.25s, color 0.25s

        html:not(.is-mode-touch) &:hover
            color $text

        &.is-active
            background $glass-strong
            color $text

    .nav-resume
        margin-left 8px
        font-size 14px
        font-weight 600
        color $blue
        text-decoration none
        white-space nowrap

.sheet-scroller
    flex 1
    min-height 0
    overflow-y auto
    overscroll-behavior contain
    outline none
    scrollbar-width thin
    scrollbar-color rgba(255, 255, 255, 0.2) transparent

.sheet-body
    width @css{ min(1120px, calc(100% - 56px)) }
    margin 0 auto
    padding 110px 0 120px

    @media only screen and (max-width 760px)
        width calc(100% - 28px)
        padding 86px 0 90px

/*
 * Presentations
 */
.keynote-bar
    flex none
    display flex
    align-items center
    gap 16px
    height 70px
    padding 0 76px 0 28px

    @media only screen and (max-width 760px)
        padding 0 62px 0 16px

.keynote-heading
    display flex
    align-items baseline
    gap 10px
    margin-right auto

.keynote-title
    font-size 16px
    font-weight 700
    letter-spacing -0.015em

.keynote-count
    font-size 14px
    font-weight 500
    color $tertiary
    font-variant-numeric tabular-nums

.keynote-pager
    display flex
    gap 8px

.round
    display flex
    align-items center
    justify-content center
    width 38px
    height 38px
    border-radius 19px
    background $glass-strong
    box-shadow inset 0 0 0 1px $stroke
    color $text
    transition background 0.25s, transform 0.3s $spring

    html:not(.is-mode-touch) &:hover
        background rgba(255, 255, 255, 0.22)
        transform scale(1.08)

    &:active
        transform scale(0.92)

.keynote-stage
    flex 1
    min-height 0
    display flex
    align-items center
    justify-content center
    padding 0 28px

    @media only screen and (max-width 760px)
        display block
        padding 0 14px
        overflow-y auto

.keynote-footer
    flex none
    display flex
    align-items center
    justify-content center
    flex-wrap wrap
    gap 10px
    min-height 78px
    padding 14px 28px 20px

    .links
        display flex
        flex-wrap wrap
        justify-content center
        gap 10px

/*
 * The grid of tiles. Sizes are in cqw (hundredths of the grid's width), so
 * the whole composition scales as one piece.
 */
.bento
    container-type inline-size
    display grid
    grid-template-columns repeat(12, minmax(0, 1fr))
    grid-template-rows repeat(6, minmax(0, 1fr))
    gap 0.9cqw
    width @css{ min(100%, calc((100dvh - 172px) * 16 / 9), 1560px) }
    aspect-ratio 16 / 9

    .tile
        position relative
        min-width 0
        min-height 0
        overflow hidden
        border-radius 1.75cqw
        background $glass
        box-shadow inset 0 0 0 1px $stroke
        opacity 0
        transform translateY(3.2cqw) scale(0.93)
        filter blur(12px)
        transition opacity 0.85s $spring, transform 1.05s cubic-bezier(0.18, 0.9, 0.24, 1.04), filter 0.85s $spring
        transition-delay calc(var(--order, 0) * 60ms)

        &::after
            content ''
            position absolute
            inset 0
            border-radius inherit
            background radial-gradient(34cqw circle at var(--light-x, 50%) var(--light-y, -20%), rgba(255, 255, 255, 0.11), transparent 62%)
            opacity 0
            transition opacity 0.35s
            pointer-events none

        html:not(.is-mode-touch) &:hover::after
            opacity 1

        &.is-emphasis
            background $glass-strong

    &.is-in .tile
        opacity 1
        transform none
        filter none

    &.is-leaving .tile
        opacity 0
        transform scale(0.97)
        filter blur(6px)
        transition-duration 0.2s
        transition-delay 0s

    .heading
        font-size 1.08cqw
        font-weight 600
        color $tertiary

    /* Hero */
    .hero
        display flex
        flex-direction column
        justify-content center
        padding 1.7cqw 2.1cqw

        .name
            font-size 4.7cqw
            font-weight 700
            letter-spacing -0.035em
            line-height 1

        &.is-medium .name
            font-size 3.7cqw

        &.is-long .name
            font-size 3cqw

        .line
            margin-top 0.75cqw
            font-size 1.62cqw
            font-weight 600
            letter-spacing -0.015em
            line-height 1.22
            color $secondary

        .meta
            margin-top 0.95cqw
            font-size 1.06cqw
            font-weight 500
            line-height 1.35
            color $tertiary

    /* Stat */
    .stat
        display flex
        flex-direction column
        justify-content center
        padding 0.9cqw 1.4cqw

        .value
            font-weight 700
            letter-spacing -0.04em
            line-height 1
            white-space nowrap
            font-variant-numeric tabular-nums

        .label
            margin-top 0.5cqw
            font-size 1.04cqw
            font-weight 500
            line-height 1.25
            color $secondary

        &.is-tall .label
            margin-top 0.8cqw
            font-size 1.26cqw

    /* Image */
    .image
        background #000000

        img
            position absolute
            inset 0
            width 100%
            height 100%
            object-fit cover
            transform scale(1.14)
            transition transform 7s cubic-bezier(0.1, 0.6, 0.2, 1)
            transition-delay calc(var(--order, 0) * 60ms)

        .caption
            position absolute
            left 0
            right 0
            bottom 0
            padding 3.6cqw 1.4cqw 1.1cqw
            background linear-gradient(transparent, rgba(0, 0, 0, 0.78))
            font-size 1.17cqw
            font-weight 600
            line-height 1.28
            letter-spacing -0.005em

        &.is-contain
            display flex
            flex-direction column
            background $glass

            .holder
                position relative
                flex 1
                min-height 0
                margin 0.9cqw 0.9cqw 0
                overflow hidden
                border-radius 1cqw
                background #ffffff

            img
                object-fit contain
                transform scale(1.04)

            .note
                padding 0.65cqw 1.3cqw 0.9cqw
                font-size 1.04cqw
                font-weight 500
                line-height 1.25
                color $secondary

    &.is-in .image img
        transform scale(1)

    /* Live */
    .live
        display flex
        flex-direction column

        canvas
            flex 1
            min-height 0
            width 100%
            display block

        .note
            padding 0.4cqw 1.3cqw 0.95cqw
            font-size 1.04cqw
            font-weight 500
            line-height 1.25
            color $secondary

    /* Steps */
    .steps
        display flex
        flex-direction column
        padding 1.25cqw 1.7cqw 1.4cqw

        .row
            flex 1
            display flex
            align-items center
            gap 1.2cqw
            margin-top 0.4cqw

        .step
            flex 1
            min-width 0
            opacity 0.42
            transition opacity 0.6s

            &.is-active,
            &.is-done
                opacity 1

        .bar
            height 0.22cqw
            margin-bottom 0.85cqw
            overflow hidden
            border-radius 0.11cqw
            background rgba(255, 255, 255, 0.14)

        .fill
            width 100%
            height 100%
            border-radius inherit
            background $text
            transform scaleX(0)
            transform-origin left center

        .step.is-done .fill
            transform scaleX(1)

        .step.is-active .fill
            transform scaleX(1)
            transition transform var(--step-duration, 1900ms) linear

        .n
            font-size 1cqw
            font-weight 700
            color $tertiary

        .t
            margin-top 0.2cqw
            font-size 1.5cqw
            font-weight 700
            letter-spacing -0.02em
            line-height 1.12

        .d
            margin-top 0.4cqw
            font-size 1.04cqw
            font-weight 500
            line-height 1.28
            color $secondary

        &.is-compact
            .row
                gap 0.9cqw

            .t
                font-size 1.28cqw

            .d
                font-size 0.96cqw

    /* List */
    .list
        display flex
        flex-direction column
        padding 1.25cqw 1.7cqw

        .rows
            flex 1
            display flex
            flex-direction column
            justify-content space-evenly
            margin-top 0.3cqw

        .item
            font-size 1.13cqw
            font-weight 500
            line-height 1.3
            color $secondary

            b
                font-weight 700
                color $text

    /* Text */
    .text
        display flex
        align-items center
        padding 1.1cqw 1.7cqw
        font-size 1.34cqw
        font-weight 600
        line-height 1.3
        letter-spacing -0.012em

        &.is-small
            font-size 1.13cqw
            font-weight 500
            color $secondary

    /* Phones: the grid becomes a column and type goes back to fixed sizes */
    @media only screen and (max-width 760px)
        display flex
        flex-direction column
        gap 10px
        width 100%
        aspect-ratio auto
        padding-bottom 20px

        .tile
            flex none
            border-radius 22px
            transform translateY(24px) scale(0.97)

        .heading
            font-size 13px

        .hero
            padding 22px

            .name
            &.is-medium .name
            &.is-long .name
                font-size 38px

            .line
                margin-top 8px
                font-size 19px

            .meta
                margin-top 10px
                font-size 13.5px

        .stat
            padding 18px 20px

            .value
                font-size 40px !important

            .label
            &.is-tall .label
                margin-top 6px
                font-size 15px

        .image
            aspect-ratio 16 / 10

            .caption
                padding 40px 16px 14px
                font-size 14.5px

            &.is-contain
                aspect-ratio auto

                .holder
                    flex none
                    aspect-ratio 16 / 10
                    margin 10px 10px 0
                    border-radius 14px

                .note
                    padding 9px 16px 13px
                    font-size 14px

        .live
            canvas
                flex none
                aspect-ratio 16 / 10

            .note
                padding 6px 16px 13px
                font-size 14px

        .steps
            padding 18px 20px

            .row
                flex-direction column
                align-items stretch
                gap 16px
                margin-top 14px

            .bar
                height 3px
                margin-bottom 9px

            .n
                font-size 12.5px

            .t
            &.is-compact .t
                font-size 18px

            .d
            &.is-compact .d
                margin-top 4px
                font-size 14.5px

        .list
            padding 18px 20px

            .rows
                gap 12px
                margin-top 12px

            .item
                font-size 15px

        .text
            padding 18px 20px
            font-size 17px

            &.is-small
                font-size 15px

@keyframes ui-pulse
    0%
        box-shadow 0 0 0 0 rgba(48, 209, 88, 0.55)
    70%
        box-shadow 0 0 0 9px rgba(48, 209, 88, 0)
    100%
        box-shadow 0 0 0 0 rgba(48, 209, 88, 0)

/*
 * The game menu (options, controls, achievements) in the same glass
 */
.menu
    .close .button-inner
        background rgba(255, 255, 255, 0.13)
        border-radius 19px

        &::after
            display none


/*
 * Chapter bar (Guide.js)
 */
.guide
    display none
    position absolute
    top 20px
    left 50%
    z-index 9
    align-items center
    gap 2px
    height 44px
    padding 0 5px
    border-radius 22px
    background rgba(22, 22, 26, 0.62)
    backdrop-filter blur(24px) saturate(180%)
    -webkit-backdrop-filter blur(24px) saturate(180%)
    box-shadow inset 0 0 0 1px $stroke
    transform translateX(-50%)
    transition opacity 0.3s, transform 0.3s $spring
    user-select none
    -webkit-user-select none

    html.is-started &
        display flex

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-intro &,
    html.input-filter-cinematic &
        opacity 0
        pointer-events none
        transform translateX(-50%) scale(0.94)

    @media only screen and (max-width 900px)
        top 68px
        max-width calc(100% - 24px)

    // On a phone: previous, the current stop, next
    @media only screen and (max-width 520px)
        top 74px
        left 12px
        right auto
        max-width none
        height 44px
        padding 0 4px
        transform none

        html.input-filter-menu &,
        html.input-filter-modal &,
        html.input-filter-intro &,
        html.input-filter-cinematic &
            transform scale(0.94)

.guide-step,
.guide-current
    display none

.guide-step
    align-items center
    justify-content center
    width 36px
    height 36px
    border-radius 18px
    color $text

    &:active
        background $glass-strong

.guide-current
    padding 0 6px
    color $text
    font-size 15px
    font-weight 600
    letter-spacing -0.01em
    white-space nowrap

@media only screen and (max-width 520px)
    .guide-step
        display flex

    .guide-current
        display block

    .guide .guide-item
        display none

.guide-item
    height 34px
    padding 0 14px
    border-radius 17px
    color $secondary
    font-size 14px
    font-weight 600
    letter-spacing -0.01em
    white-space nowrap
    transition background 0.25s, color 0.25s

    html:not(.is-mode-touch) &:hover
        color $text

    &.is-active
        background $glass-strong
        color $text



/*
 * Boot indicator: visible until the world is ready to start
 */
.boot
    position absolute
    left 50%
    bottom 12%
    z-index 3
    display flex
    flex-direction column
    align-items center
    gap 12px
    transform translateX(-50%)
    pointer-events none
    transition opacity 0.5s

    html.is-ready &
        opacity 0

.boot-track
    width 168px
    height 2px
    border-radius 1px
    background rgba(255, 255, 255, 0.14)
    overflow hidden

.boot-bar
    width 40%
    height 100%
    border-radius 1px
    background #5fd4ff
    animation boot-slide 1.25s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate
    will-change transform

.boot-label
    margin 0
    color rgba(235, 235, 245, 0.62)
    font-size 13px
    font-weight 500
    letter-spacing 0.01em

@keyframes boot-slide
    from
        transform translateX(-10%)
    to
        transform translateX(160%)


/*
 * Presentations take the project's colours (data/themes.js): the title tile
 * is its cover colour, numbers and progress are its accent, and a product's
 * first picture sits in the window it runs in.
 */
.bento
    .tile.hero.is-themed
        background var(--hero-bg)
        box-shadow none
        color var(--hero-ink)

        .line
            color var(--hero-ink)
            opacity 0.84

        .meta
            color var(--hero-ink)
            opacity 0.58

        // In the corner, so a long title keeps its room
        .mark
            position absolute
            top 1.5cqw
            right 1.5cqw
            display flex
            align-items center
            justify-content center
            width 3.3cqw
            height 3.3cqw
            border-radius 0.85cqw
            overflow hidden
            box-shadow 0 0.5cqw 1.4cqw rgba(0, 0, 0, 0.22), 0 0 0 1px rgba(0, 0, 0, 0.08)

            img
                width 100%
                height 100%
                padding 14%
                object-fit contain

    .stat .value
        color var(--accent)

    .steps .step .fill
        background var(--accent)

    .tile.image.is-window
        display flex
        padding 1.5cqw 1.5cqw 0
        background unquote('color-mix(in srgb, var(--accent) 22%, #0c0e12)')

        .window
            flex 1
            min-height 0
            display flex
            flex-direction column
            border-radius 0.9cqw 0.9cqw 0 0
            overflow hidden
            background #17181c
            box-shadow 0 1.6cqw 3.6cqw rgba(0, 0, 0, 0.42), 0 0 0 1px rgba(128, 128, 128, 0.26)

        .bar
            flex none
            display flex
            align-items center
            gap 0.45cqw
            height 2.1cqw
            padding 0 0.9cqw
            background #1d1e23

            i
                width 0.62cqw
                height 0.62cqw
                border-radius 50%
                background #ff5f57

                &:nth-child(2)
                    background #febc2e

                &:nth-child(3)
                    background #28c840

        &.is-light .window
            background #ffffff

        &.is-light .bar
            background #ebecef

        img
            position static
            flex 1
            min-height 0
            width 100%
            height auto
            object-fit cover
            object-position top
            transform none


/* Menu tabs that are switched off (see Menu.js) */
.menu .js-navigation-item[hidden]
    display none
