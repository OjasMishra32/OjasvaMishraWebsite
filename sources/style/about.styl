/*
 * The About page (Profile.js): an ordinary light page that covers the world.
 *
 * Unbounded for headings, Space Grotesk for text, white cards on a slow
 * aurora, logos as small 3D chips. Nothing in here uses a blur over the
 * canvas, and the world is paused while the page is open.
 */
$a-fg = #020817
$a-ink = #0f172a
$a-slate = #334155
$a-muted = #64748b
$a-faint = #94a3b8
$a-border = #e2e8f0
$a-card = rgba(255, 255, 255, 0.94)
$a-display = 'Unbounded', 'Inter', system-ui, sans-serif
$a-body = 'Space Grotesk', 'Inter', system-ui, sans-serif
$a-mono = ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace
$a-ease = cubic-bezier(0.2, 0.8, 0.2, 1)

/* The page is opaque, so the scrim has nothing to blur */
.modals:has(.modal.profile.is-displayed)
    background #eef2f8
    backdrop-filter none
    -webkit-backdrop-filter none

.modals .modal.sheet.profile
    overflow hidden
    background linear-gradient(180deg, #f7f9fc 0%, #eef2f8 55%, #e9eef6 100%)
    color $a-fg
    font-family $a-body
    font-weight 500
    letter-spacing 0

    *::selection
        color #ffffff
        background $a-ink

    /* Aurora: three soft lights drifting, drawn as gradients (no filter) */
    &::before
        content ''
        position absolute
        inset -20%
        background radial-gradient(38% 34% at 22% 26%, rgba(56, 130, 246, 0.20), transparent 70%), radial-gradient(34% 32% at 80% 22%, rgba(168, 85, 247, 0.15), transparent 70%), radial-gradient(40% 36% at 62% 82%, rgba(20, 184, 166, 0.15), transparent 70%)
        animation about-aurora 38s ease-in-out infinite alternate
        pointer-events none

    /* Faint grid, fading out toward the edges */
    &::after
        content ''
        position absolute
        inset 0
        background-image linear-gradient(rgba(15, 23, 42, 0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.055) 1px, transparent 1px)
        background-size 64px 64px
        mask-image radial-gradient(ellipse 80% 70% at 50% 40%, #000 30%, transparent 78%)
        -webkit-mask-image radial-gradient(ellipse 80% 70% at 50% 40%, #000 30%, transparent 78%)
        pointer-events none

    > *
        z-index 1

    .sheet-scroller
        position relative
        scrollbar-color rgba(15, 23, 42, 0.22) transparent

    .sheet-body
        width @css{ min(1180px, calc(100% - 64px)) }
        padding 0 0 120px

        @media only screen and (max-width 760px)
            width calc(100% - 36px)
            padding 0 0 90px

    /* Header */
    .sheet-bar
        z-index 4
        color $a-ink

        &.is-scrolled
            background rgba(247, 249, 252, 0.86)
            backdrop-filter blur(14px)
            -webkit-backdrop-filter blur(14px)
            box-shadow 0 1px 0 $a-border

        .nav-name
            font-family $a-display
            font-size 14px
            font-weight 700
            letter-spacing -0.01em
            color $a-ink
            opacity 0
            transition opacity 0.3s

        &.is-scrolled .nav-name
            opacity 1

        .nav-item
            font-family $a-body
            font-size 14px
            font-weight 500
            color $a-muted

            html:not(.is-mode-touch) &:hover
                color $a-ink

            &.is-active
                background rgba(15, 23, 42, 0.07)
                color $a-ink

            @media only screen and (max-width 760px)
                padding 0 9px
                font-size 13px

    .sheet-close
        z-index 5
        background #ffffff
        box-shadow inset 0 0 0 1px $a-border, 0 1px 2px rgba(15, 23, 42, 0.06)
        color $a-ink

        html:not(.is-mode-touch) &:hover
            background #f1f5f9

    button
        font-family inherit
        color inherit
        text-align left
        cursor pointer

    h1, h2, h3
        margin 0
        font-family $a-display
        color $a-ink

    p
        margin 0

    /*
     * Entrances
     */
    .js-reveal.blur-in
        opacity 0
        filter blur(12px)
        transform translateY(8px)
        transition opacity 0.9s ease, filter 0.9s ease, transform 0.9s $a-ease
        transition-delay calc(0.12s + var(--d, 0) * 0.13s)

        &.is-in
            opacity 1
            filter none
            transform none

    .js-reveal.fade-up
        opacity 0
        transform translateY(24px)
        transition opacity 0.5s ease, transform 0.6s $a-ease, border-color 0.3s, box-shadow 0.3s
        transition-delay calc(var(--i, 0) * 0.07s)

        &.is-in
            opacity 1
            transform none

    /* A solid block wipes across and leaves the content behind it */
    .js-reveal.box-reveal
        position relative
        display inline-block
        overflow hidden
        vertical-align top

        > *
            opacity 0

        &::after
            content ''
            position absolute
            inset 0
            border-radius 4px
            background $a-ink
            clip-path inset(0 100% 0 0)
            pointer-events none

        &.is-in > *
            animation about-box-content 0.01s linear forwards
            animation-delay calc(0.3s + var(--d, 0) * 0.13s)

        &.is-in::after
            animation about-box 0.7s cubic-bezier(0.65, 0, 0.35, 1) forwards
            animation-delay calc(var(--d, 0) * 0.13s)

    .js-reveal.swing-in
        opacity 0
        transform perspective(700px) translateZ(-160px) rotateY(-70deg) rotateX(18deg) scale(0.6)
        transition opacity 0.5s ease, transform 1.1s cubic-bezier(0.2, 1.25, 0.3, 1)
        transition-delay calc(0.15s + var(--d, 0) * 0.12s)

        &.is-in
            opacity 1
            transform perspective(700px)

    /*
     * Logo chips
     */
    .chip
        --size 64px
        --depth 14px
        position relative
        display block
        flex none
        width var(--size)
        height var(--size)
        perspective calc(var(--size) * 4)

        &.is-large
            --size 92px
            --depth 18px

        &.is-hero
            --size 128px
            --depth 26px

    .chip-shadow
        position absolute
        left 6%
        right 6%
        bottom -9%
        height 18%
        border-radius 50%
        background radial-gradient(ellipse at center, rgba(15, 23, 42, 0.34), rgba(15, 23, 42, 0) 70%)

    .chip-float,
    .chip-tilt
        position absolute
        inset 0
        display block
        transform-style preserve-3d

    .chip-float
        transform rotateY(-22deg) rotateX(9deg)
        animation about-chip-float calc(8s + var(--n, 0) * 0.6s) ease-in-out infinite
        animation-delay calc(var(--n, 0) * -1.3s)
        animation-play-state paused

    .chip.is-floating .chip-float
        animation-play-state running

    .chip-tilt
        transform rotateX(calc(var(--py, 0) * -44deg)) rotateY(calc(var(--px, 0) * 56deg))
        transition transform 0.45s $a-ease

    .chip-slice,
    .chip-face
        position absolute
        inset 0
        display block
        border-radius 23%

    .chip-slice
        transform translateZ(calc((var(--t) - 0.5) * var(--depth)))

    .chip-face
        display flex
        align-items center
        justify-content center
        overflow hidden
        background var(--chip-bg)
        box-shadow inset 0 0 0 1px rgba(255, 255, 255, 0.16), inset 0 0 0 1px rgba(15, 23, 42, 0.07)
        transform translateZ(calc(var(--depth) * 0.5))

        img
            display block
            width 100%
            height 100%
            padding 12%
            object-fit contain
            user-select none

        /* Light from above */
        &::after
            content ''
            position absolute
            inset 0
            background linear-gradient(to bottom, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 45%)
            pointer-events none

    .chip-text
        font-family $a-display
        font-size calc(var(--size) * 0.2)
        font-weight 700
        letter-spacing -0.02em
        color #ffffff

    .chip-sheen
        position absolute
        top 0
        bottom 0
        left -50%
        width 50%
        background linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent)
        transform translateX(calc(50% - var(--px, 0) * 160%)) skewX(12deg)
        transition transform 0.45s $a-ease
        pointer-events none

    /*
     * Shared pieces
     */
    .card
        display block
        width 100%
        border 1px solid $a-border
        border-radius 16px
        background $a-card
        box-shadow 0 1px 2px rgba(15, 23, 42, 0.04)

        html:not(.is-mode-touch) &:hover
            border-color rgba(15, 23, 42, 0.3)
            box-shadow 0 14px 34px -16px rgba(15, 23, 42, 0.28)

    .btn
        display inline-flex
        align-items center
        justify-content center
        gap 8px
        height 42px
        padding 0 18px
        border 1px solid $a-border
        border-radius 9px
        background #ffffff
        color $a-ink
        font-size 14px
        font-weight 600
        line-height 1
        text-decoration none
        white-space nowrap
        transition background 0.2s, border-color 0.2s, transform 0.3s $a-ease

        html:not(.is-mode-touch) &:hover
            background #f1f5f9

        &:active
            transform scale(0.97)

        &.is-solid
            border-color $a-ink
            background $a-ink
            color #f8fafc

            html:not(.is-mode-touch) &:hover
                background #1e293b

    .icon-button
        display inline-flex
        align-items center
        justify-content center
        width 42px
        height 42px
        border 1px solid $a-border
        border-radius 9px
        background #ffffff
        color $a-ink
        transition background 0.2s, transform 0.3s $a-ease

        html:not(.is-mode-touch) &:hover
            background #f1f5f9
            transform translateY(-2px)

    .slash
        margin 0 9px
        opacity 0.4

    .arrow
        flex none
        margin-left 3px
        opacity 0
        transform translate(-3px, 3px)
        transition opacity 0.2s, transform 0.25s $a-ease

    .mono-label
        font-family $a-mono
        font-size 11px
        font-weight 500
        letter-spacing 0.16em
        text-transform uppercase
        color $a-muted

    .mono-note
        margin-top 5px
        font-family $a-mono
        font-size 12px
        font-weight 400
        color $a-muted

    .text-link
        display inline-flex
        align-items center
        padding 0
        font-size 14px
        font-weight 600
        color $a-ink
        text-decoration underline
        text-decoration-color rgba(100, 116, 139, 0.45)
        text-underline-offset 4px
        transition text-decoration-color 0.2s

        html:not(.is-mode-touch) &:hover
            text-decoration-color $a-ink

            .arrow
                opacity 1
                transform none

    /*
     * Sections
     */
    .about-section
        padding-top 120px

        @media only screen and (max-width 760px)
            padding-top 84px

    .section-header
        margin-bottom 56px
        text-align center

        h2
            padding 2px 6px 6px
            font-size @css{ clamp(34px, 6vw, 72px) }
            font-weight 700
            line-height 1.05
            letter-spacing -0.035em

        p
            margin-top 14px
            font-size 17px
            color $a-muted

        @media only screen and (max-width 760px)
            margin-bottom 36px

    /*
     * Hero
     */
    .about-hero
        display grid
        grid-template-columns minmax(0, 1.15fr) minmax(0, 0.85fr)
        align-items center
        gap 40px
        min-height 100vh
        padding-top 90px
        padding-bottom 40px

        @media only screen and (max-width 980px)
            grid-template-columns 1fr
            min-height 0
            padding-top 110px

    .hero-hi,
    .hero-line
        font-size 20px
        color $a-muted

        @media only screen and (max-width 760px)
            font-size 17px

    .hero-copy h1
        margin 6px 0 14px -5px
        font-size @css{ clamp(54px, 9.4vw, 132px) }
        font-weight 700
        line-height 0.98
        letter-spacing -0.045em
        color #1e293b

    .credentials
        display flex
        flex-direction column
        gap 7px
        margin 26px 0 0
        padding 0 0 0 16px
        border-left 1px solid #cbd5e1
        list-style none
        font-size 16px
        color $a-muted

        .credential-label
            color $a-slate

        .credential-detail
            font-family $a-mono
            font-size 14px
            font-weight 400

        a.credential-detail
            text-decoration underline
            text-decoration-color rgba(100, 116, 139, 0.45)
            text-underline-offset 4px
            transition color 0.2s, text-decoration-color 0.2s

            html:not(.is-mode-touch) &:hover
                color $a-ink
                text-decoration-color $a-ink

        @media only screen and (max-width 760px)
            font-size 14px

            .credential-detail
                font-size 12px

    .hero-buttons
        display flex
        flex-wrap wrap
        gap 12px
        margin-top 32px

    .hero-socials
        display flex
        gap 8px
        margin-top 12px

    // The skills keyboard takes the right half once its scene has loaded;
    // until then (and on small screens) the logo chips stand there
    .hero-keyboard
        display none
        position relative
        grid-column 2
        grid-row 1
        align-self stretch
        min-height 560px

        // Wider than its column so the keyboard can turn without being cut off
        canvas
            position absolute
            top 0
            left -18%
            width 136% !important
            height 100% !important
            outline none

    .about-hero.has-keyboard
        .hero-keyboard
            display block

        .hero-chips
            display none

    .keyboard-caption
        position absolute
        left 50%
        bottom 6%
        width @css{ min(380px, 90%) }
        text-align center
        opacity 0
        transform translate(-50%, 8px)
        transition opacity 0.25s, transform 0.3s $a-ease
        pointer-events none

        &.is-visible
            opacity 1
            transform translate(-50%, 0)

        b
            display block
            font-family $a-display
            font-size 22px
            font-weight 700
            letter-spacing -0.02em
            color $a-ink

        span
            display block
            margin-top 6px
            font-size 15px
            line-height 1.45
            color $a-muted

    .hero-chips
        display grid
        grid-template-columns repeat(2, 128px)
        justify-content center
        gap 54px 62px

        .hero-chip:nth-child(odd)
            margin-top 46px

        .hero-chip:nth-child(even)
            margin-top -18px

        @media only screen and (max-width 980px)
            display none

    /*
     * Experience
     */
    .timeline
        display flex
        flex-direction column
        gap 22px
        max-width 940px
        margin 0 auto

    .role
        display grid
        grid-template-columns auto minmax(0, 1fr)
        gap 26px
        padding 30px 32px

        h3
            font-size 21px
            font-weight 700
            line-height 1.2
            letter-spacing -0.025em

        @media only screen and (max-width 760px)
            grid-template-columns 1fr
            gap 18px
            padding 22px 20px

            h3
                font-size 18px

    .role-logo
        padding-top 2px

    .role-top
        display flex
        align-items flex-start
        justify-content space-between
        gap 16px

        @media only screen and (max-width 760px)
            flex-direction column
            gap 12px

    .role-company
        margin-top 6px
        font-size 16px
        color $a-slate

        a
            display inline-flex
            align-items center
            text-decoration none

            html:not(.is-mode-touch) &:hover
                color $a-ink

                .arrow
                    opacity 1
                    transform none

    .badge
        flex none
        padding 5px 11px
        border-radius 999px
        background #f1f5f9
        font-size 12px
        font-weight 600
        white-space nowrap
        color $a-slate

        &.is-current
            background $a-ink
            color #f8fafc

    .role-metrics
        display flex
        flex-wrap wrap
        margin 22px 0 0
        border-top 1px solid $a-border
        border-bottom 1px solid $a-border

        div
            flex 1 1 0
            min-width 130px
            padding 14px 18px 14px 0

            & + div
                padding-left 18px
                border-left 1px solid $a-border

        dt
            font-family $a-display
            font-size 19px
            font-weight 700
            line-height 1.2
            letter-spacing -0.03em
            color $a-ink

        dd
            margin 5px 0 0
            font-size 13px
            line-height 1.35
            color $a-muted

        @media only screen and (max-width 760px)
            div
                flex 1 1 100%
                padding 11px 0

                & + div
                    padding-left 0
                    border-left 0
                    border-top 1px solid $a-border

    .role-points
        display flex
        flex-direction column
        gap 9px
        margin 20px 0 0
        padding 0
        list-style none

        li
            position relative
            padding-left 18px
            font-size 15px
            font-weight 400
            line-height 1.6
            color $a-slate

            &::before
                content ''
                position absolute
                top 0.68em
                left 2px
                width 5px
                height 5px
                border-radius 50%
                background #cbd5e1

    /*
     * Research
     */
    .papers
        display flex
        flex-direction column
        gap 18px
        max-width 940px
        margin 0 auto
        padding 0
        list-style none

    .paper
        padding 28px 32px

        h3
            margin-top 14px
            font-size 19px
            font-weight 700
            line-height 1.32
            letter-spacing -0.025em

        @media only screen and (max-width 760px)
            padding 22px 20px

            h3
                font-size 16px

    .paper-top
        display flex
        flex-wrap wrap
        align-items center
        gap 8px 12px
        font-size 13px
        color $a-muted

    .venue-pill
        padding 4px 11px
        border 1px solid $a-border
        border-radius 999px
        background #ffffff
        font-size 12px
        font-weight 600
        color $a-ink

    .paper-year
        margin-left auto
        font-family $a-mono
        font-size 12px

    .paper-authors
        margin-top 9px
        font-size 14px
        color $a-muted

        strong
            font-weight 600
            color $a-ink

    .paper-abstract
        margin-top 12px
        font-size 15px
        font-weight 400
        line-height 1.6
        color $a-slate

    .paper-links
        display flex
        flex-wrap wrap
        gap 8px 22px
        margin-top 16px

    /*
     * Projects
     */
    .featured
        display grid
        grid-template-columns repeat(2, minmax(0, 1fr))
        gap 20px

        @media only screen and (max-width 900px)
            grid-template-columns 1fr

    .featured-card
        display flex
        align-items flex-end
        justify-content space-between
        gap 24px
        min-height 300px
        padding 34px

        h3
            margin-top 14px
            font-size @css{ clamp(30px, 3.4vw, 46px) }
            font-weight 700
            line-height 1.05
            letter-spacing -0.04em

        html:not(.is-mode-touch) &:hover
            transform translateY(-4px)

        @media only screen and (max-width 760px)
            min-height 0
            padding 24px 20px

    .featured-main
        align-self stretch
        display flex
        flex-direction column

    .featured-tagline
        max-width 34ch
        margin-top 14px
        font-size 16px
        font-weight 400
        line-height 1.55
        color $a-slate

    .featured-meta
        margin-top auto
        padding-top 26px
        font-size 13px
        line-height 1.6
        color $a-muted

        .meta-strong
            font-weight 600
            color $a-ink

    .project-grid
        display grid
        grid-template-columns repeat(3, minmax(0, 1fr))
        gap 20px
        margin-top 20px

        @media only screen and (max-width 1000px)
            grid-template-columns repeat(2, minmax(0, 1fr))

        @media only screen and (max-width 640px)
            grid-template-columns 1fr

    .project
        display flex
        flex-direction column
        min-height 318px
        padding 24px

        h3
            font-size 24px
            font-weight 700
            line-height 1.12
            letter-spacing -0.035em

        html:not(.is-mode-touch) &:hover
            transform translateY(-4px)

            .arrow
                opacity 1
                transform none

    .project-top
        display flex
        align-items baseline
        justify-content space-between
        gap 12px
        font-family $a-mono
        font-size 11px
        font-weight 400
        color $a-muted

        span:last-child
            flex none
            white-space nowrap

    .project-main
        margin-top 26px

    .project-tagline
        margin-top 10px
        font-size 14.5px
        font-weight 400
        line-height 1.55
        color $a-slate

    .project-foot
        display flex
        align-items flex-end
        justify-content space-between
        gap 16px
        margin-top auto
        padding-top 22px

        > div
            flex 1
            min-width 0
            padding-top 14px
            border-top 1px solid $a-border

    .project-proof
        font-size 13px
        font-weight 600
        line-height 1.45
        color $a-ink

    .project-role
        display flex
        align-items center
        margin-top 4px
        font-size 13px
        color $a-muted

    /*
     * Contact
     */
    .about-contact
        text-align center

    .contact-email
        display inline-block
        font-family $a-display
        font-size @css{ clamp(19px, 3.6vw, 44px) }
        font-weight 700
        letter-spacing -0.035em
        color $a-ink
        text-decoration underline
        text-decoration-color rgba(100, 116, 139, 0.35)
        text-decoration-thickness 2px
        text-underline-offset 8px
        transition text-decoration-color 0.25s

        html:not(.is-mode-touch) &:hover
            text-decoration-color $a-ink

    .contact-buttons
        display flex
        flex-wrap wrap
        justify-content center
        gap 12px
        margin-top 34px

    @media (prefers-reduced-motion: reduce)
        &::before,
        .chip-float
            animation none

/*
 * Cursor (About/Cursor.js) and reactions (About/Reactions.js)
 */
.modals .modal.sheet.profile
    &.has-cursor,
    &.has-cursor *
        cursor none

    &.is-shaking .sheet-scroller
        animation about-shake 0.36s linear

.about-cursor-jelly,
.about-cursor-dot
    position fixed
    left 0
    top 0
    z-index 60
    pointer-events none
    opacity 0
    will-change transform
    backdrop-filter invert(100%)
    -webkit-backdrop-filter invert(100%)

.about-cursor-jelly
    width 50px
    height 50px
    border 2px solid #000000
    border-radius 25px
    box-sizing border-box

.about-cursor-dot
    z-index 61
    width 12px
    height 12px
    border-radius 50%

.reactions
    position fixed
    z-index 70
    width 0
    height 0
    pointer-events none
    font-family system-ui, -apple-system, 'Inter', sans-serif

    > *
        position absolute
        opacity 0
        transition opacity 0.15s

    &.is-open > *
        opacity 1

    .reactions-ring
        left 0
        top 0
        border 2px solid transparent
        border-radius 50%
        transform translate(-50%, -50%)

    .reactions-center
        left -24px
        top -24px
        display flex
        align-items center
        justify-content center
        width 48px
        height 48px
        border-radius 50%
        background rgba(23, 23, 23, 0.82)
        box-shadow 0 0 0 1px rgba(255, 255, 255, 0.1), 0 20px 40px rgba(0, 0, 0, 0.35)
        transform scale(0)
        transition transform 0.25s cubic-bezier(0.3, 1.5, 0.5, 1), opacity 0.15s

    &.is-open .reactions-center
        transform none

    .reactions-dot
        border-radius 50%

    .reactions-label
        left 0
        top 32px
        transform translateX(-50%)
        font-family ui-monospace, 'SF Mono', Menlo, monospace
        font-size 11px
        font-weight 700
        white-space nowrap

    .reactions-item
        left -28px
        top -28px
        display flex
        align-items center
        justify-content center
        width 56px
        height 56px
        border-radius 50%
        background #262626
        box-shadow 0 0 0 1px #404040, 0 10px 20px rgba(0, 0, 0, 0.3)
        transform scale(0)
        transition transform 0.3s cubic-bezier(0.3, 1.5, 0.5, 1), background 0.2s, opacity 0.15s

        span
            font-size 24px
            line-height 1

        em
            position absolute
            top 64px
            padding 4px 8px
            border-radius 4px
            background rgba(0, 0, 0, 0.8)
            color #ffffff
            font-size 12px
            font-style normal
            white-space nowrap
            opacity 0
            transition opacity 0.15s

        &.is-active
            background var(--color)
            box-shadow 0 0 0 1px var(--color), 0 10px 20px rgba(0, 0, 0, 0.3)

            em
                opacity 1

    &.is-open .reactions-item
        transform translate(var(--x), var(--y))

        &.is-active
            transform translate(var(--x), var(--y)) scale(1.2)

    &.is-disabled .reactions-item
        opacity 0.4
        filter grayscale(1)

.reactions-hint
    position fixed
    top 78px
    left 50%
    z-index 50
    padding 9px 16px
    border-radius 999px
    background rgba(23, 23, 23, 0.84)
    box-shadow 0 0 0 1px rgba(255, 255, 255, 0.1), 0 10px 24px rgba(0, 0, 0, 0.2)
    color rgba(255, 255, 255, 0.78)
    font-family system-ui, -apple-system, 'Inter', sans-serif
    font-size 14px
    white-space nowrap
    pointer-events none
    opacity 0
    transform translate(-50%, 10px)
    transition opacity 0.4s, transform 0.4s

    &.is-visible
        opacity 1
        transform translate(-50%, 0)

.reactions-wave
    position fixed
    z-index 69
    width 0
    height 0
    pointer-events none

    i
        position absolute
        left 0
        top 0
        border 3px solid var(--color)
        border-radius 50%
        transform translate(-50%, -50%)
        animation about-wave 1.4s ease-out forwards
        --size calc(300px * var(--s))

        &:nth-child(2)
            border-width 2px
            animation-duration 1.1s
            animation-delay 0.1s
            --size calc(200px * var(--s))

        &:nth-child(3)
            border-width 1px
            animation-duration 0.8s
            animation-delay 0.2s
            --size calc(120px * var(--s))

    b
        position absolute
        left 0
        top 0
        font-size 36px
        line-height 1
        font-weight 400
        animation about-flash 1.2s ease-out forwards

@keyframes about-wave
    from
        width 0
        height 0
        opacity 1
    to
        width var(--size)
        height var(--size)
        opacity 0

@keyframes about-flash
    from
        transform translate(-50%, -50%) scale(0)
        opacity 1
    to
        transform translate(-50%, -50%) scale(var(--flash))
        opacity 0

@keyframes about-shake
    0%
        transform translate(calc(1.2px * var(--shake)), calc(-0.75px * var(--shake)))
    33%
        transform translate(calc(-0.9px * var(--shake)), calc(0.6px * var(--shake)))
    66%
        transform translate(calc(0.45px * var(--shake)), calc(-0.3px * var(--shake)))
    100%
        transform none

@keyframes about-aurora
    0%
        transform translate3d(-3%, -2%, 0) scale(1)
    50%
        transform translate3d(4%, 3%, 0) scale(1.08)
    100%
        transform translate3d(-2%, 5%, 0) scale(1.03)

@keyframes about-box
    0%
        clip-path inset(0 100% 0 0)
    50%
        clip-path inset(0 0 0 0)
    100%
        clip-path inset(0 0 0 100%)

@keyframes about-box-content
    to
        opacity 1

@keyframes about-chip-float
    0%, 100%
        transform rotateY(-28deg) rotateX(12deg) translateY(0)
    50%
        transform rotateY(-10deg) rotateX(5deg) translateY(-7px)
