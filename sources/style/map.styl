.map-trigger
    display none
    position absolute
    right 0
    top 70px
    width 44px
    height 44px
    z-index 9
    -webkit-user-select none
    -moz-user-select none
    user-select none

    html.is-started &
        display block

    html.input-filter-menu &
    html.input-filter-cinematic &
    html.input-filter-intro &
        pointer-events none

    --hover-translate 4px

    html:not(.is-mode-touch) &:hover
        .button-inner
            transform translateX(-4px)

            &::after
                opacity 0.8

            .icon-container
                opacity 1

    .button-inner
        position absolute
        top 0
        left 0
        width calc(100% + var(--hover-translate))
        height 100%
        background radial-gradient(ellipse at top right, #C21515, #46123B)
        transition transform 0.15s 0.15s

        html.input-filter-menu &,
        html.input-filter-modal &,
        html.input-filter-intro &
        html.input-filter-cinematic &
            transform translateX(100%)
            transition-delay 0

        &::after
            content: ''
            display block
            position absolute
            top 3px
            right 0
            bottom 3px
            left 3px
            border 1px solid #ffffff
            border-right none
            opacity 0.35
            transition opacity 0.15s

        .icon-container
            display flex
            position absolute
            align-items center
            justify-content center
            top 0
            right 0
            bottom 0
            left 3px

            // .icon
            //     position relative
            //     width 20px
            //     height 14px

.map
    position relative
    width 1024px
    height 1024px
    max-width @css{ min(100vmin - 28px, 100vh - 96px) }
    max-height @css{ min(100vmin - 28px, 100vh - 96px) }
    aspect-ratio 1 / 1
    border-radius 22px
    background #05080f
    box-shadow 0 0 0 1px rgba(143, 216, 255, 0.22), 0 30px 80px -20px rgba(0, 0, 0, 0.7)
    -webkit-user-select none
    -moz-user-select none
    user-select none

    @media only screen and (max-width 1100px)
        width 768px
        height 768px

    @media only screen and (max-width 800px)
        width 512px
        height 512px

    /**
     * Close
     */
    .close
        position absolute
        top 14px
        right 14px
        z-index 2000
        width 38px
        height 38px
        border-radius 19px
        background rgba(12, 16, 26, 0.78)
        box-shadow inset 0 0 0 1px rgba(255, 255, 255, 0.14)
        transition background 0.25s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1)

        html:not(.is-mode-touch) &:hover
            background rgba(40, 52, 76, 0.9)
            transform scale(1.08)

        &:active
            transform scale(0.94)

        .button-inner,
        .icon-container
            display flex
            align-items center
            justify-content center
            width 100%
            height 100%

        .icon
            &.is-default
                width 14px
                height 14px

                .is-mode-gamepad.is-gamepad-xbox &
                    display none

            &.is-xbox
                display none
                font-size 13px
                font-weight 700
                color #ffffff

                .is-mode-gamepad.is-gamepad-xbox &
                    display block

    .map-container
        position absolute
        inset 0
        overflow hidden
        border-radius 22px

    .texture
        display block
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        pointer-events none
        opacity 0
        transition opacity 0.3s

        &.is-visible
            opacity 1

    .player
        display block
        position absolute
        top 0
        left 0
        z-index 1500
        pointer-events none

        &::after
            content ''
            position absolute
            width 64px
            height 64px
            top -32px
            left -32px
            background url('../ui/map/rover.svg') center / contain no-repeat
            filter drop-shadow(0 0 10px rgba(57, 183, 255, 0.75))

            @media only screen and (max-width 800px)
                width 46px
                height 46px
                top -23px
                left -23px

            @media only screen and (max-width 440px)
                width 34px
                height 34px
                top -17px
                left -17px

    .location
        --size 44px
        position absolute
        width var(--size)
        height var(--size)
        margin-top calc(var(--size) / -2)
        margin-left calc(var(--size) / -2)
        cursor pointer

        .pin
            position absolute
            top calc(50% - 5px)
            left calc(50% - 5px)
            width 10px
            height 10px
            border-radius 50%
            background #f2f5ff
            box-shadow 0 0 0 3px rgba(5, 8, 15, 0.9), 0 0 0 4.5px rgba(143, 216, 255, 0.75)
            transition transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1)

            @media only screen and (max-width 520px)
                top calc(50% - 3.5px)
                left calc(50% - 3.5px)
                width 7px
                height 7px

        .name-container
            display flex
            justify-content center
            position absolute
            bottom calc(50% + 13px)
            left 50%
            width 0
            pointer-events none

            .name
                padding 5px 10px
                border-radius 999px
                background rgba(10, 14, 24, 0.86)
                box-shadow inset 0 0 0 1px rgba(255, 255, 255, 0.12)
                color #f2f5ff
                font-size 13px
                font-weight 600
                letter-spacing -0.005em
                line-height 1
                white-space nowrap
                transition background 0.25s, color 0.25s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1)

                @media only screen and (max-width 800px)
                    padding 4px 7px
                    font-size 11px

                @media only screen and (max-width 520px)
                    padding 3px 5px
                    font-size 9px

                br
                    display none

        html:not(.is-mode-touch) &:hover
            .pin
                transform scale(1.35)

            .name
                background #f2f5ff
                color #05080f
                transform translateY(-2px)
