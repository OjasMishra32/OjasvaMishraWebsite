{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/blogs", "destination": "/", "permanent": true },
    { "source": "/blogs/:slug", "destination": "/", "permanent": true }
  ]
}
